flex-version = flex
support-for-ie = false
vendor-prefixes = official
@require '../../node_modules/nib/index.styl'
@require 'variables'
@require 'modern-variables'
@require 'vendor/*'
@require 'defaults/*'

global-reset()
reset-html5()

*
  box-sizing border-box

html, body, #app
  background var(--app-bg)
  font-family var(--font-primary)

html
  overflow auto

a
  color var(--link)
  text-decoration none

  &:hover
    color var(--hover)

.desktop-only
  display none

.dont-break-out
  /* These are technically the same, but use both */
  overflow-wrap break-word
  word-wrap break-word

  -ms-word-break break-all
  /* This is the dangerous one in WebKit, as it breaks things wherever */
  word-break break-all
  /* Instead use this non-standard one */
  word-break break-word

  /* Adds a hyphen where the word breaks, if supported (No Blink)
  -ms-hyphens auto
  -moz-hyphens auto
  -webkit-hyphens auto
  hyphens auto
  */

.tm-li-title
  font-weight bold

.tm-part-title
  font-weight bold

.tm-part-header
  background var(--box-shadow)

.tm-li
  border-bottom 0.0rem solid var(--bc-dim)

.tm-li-dd
  overflow hidden!important

.tm-page-header-title
  display none

.header-item-logo
  padding 1.2rem 1rem !important;



.tm-page-main
  padding-top 0!important;

.tm-page-header
  height 4.5rem;

#app
  df()
  color var(--txt)
  padding-top 3rem
  height 100vh
  width 100vw
  font-family "Roboto Mono", monospace
  max-width 100% // fixes bug where horizontal scrollbar appears
  font-weight var(--font-weight, 300) // fixes 300 weight too thin on windows
  overflow:auto;
  display flex
  flex-flow column nowrap
  min-width 0

.tm-field, .tm-field
  border-radius 2px!important
  padding 0.5rem !important

input.ni-field
  height inherit !important

.ni-select .ni-field-select-addon
  height 100% !important
menu {
  -webkit-margin-before: 0;
  -webkit-margin-after: 0;
  -webkit-padding-start 0
  -webkit-padding-end 0
}
#app-content
  flex 1
  display flex
  flex-flow column no-wrap

#app-header
  background var(--app-fg)

@media screen and (max-width: 1023px)
  .tm-page-header
    height 0

  .tm-page-header-container
    border 0!important;

  .tm-tool-bar-container
    background var(--app-bg)!important

  .header-item-logo
    border-bottom 0!important

@media screen and (min-width: 1024px)
  #app
    padding-top 0
    flex-flow row nowrap

  #app-content
    display flex
    min-width 0

 .desktop-only
    display inline

  .header-item-logo
    height 4.5rem
    border-bottom 0.0625rem solid var(--bc);

  .tm-page-header-container 
    height 100%

/* Basic table styling */
table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 8px;
  text-align: left;
  
}

table.BlocksTable {
  width: 100%;
  border-collapse: collapse;
  margin-top: 1rem;
  font-size: 0.95rem;
}

table.BlocksTable thead {
  color: #ccc;
  font-weight: 600;
  font-size: 13px;
  text-transform: uppercase;
}

table.BlocksTable th, table.BlocksTable td {
  padding: 0.75rem;
  border: 1px solid #333;
  text-align: left;
  background-color: transparent;
}

table.BlocksTable tbody tr:nth-child(odd) {
}

table.BlocksTable td:nth-child(2),
table.BlocksTable td:nth-child(3) {
}

.tm-part-title
  font-weight: bold;
  font-size: 1.2rem!important;
  color: var(--txt);
.tm-part-header
  display: block;
  padding: 1rem;
  background-color: #181818;
  border: 1px solid #333;


.BlocksTable {
  width: 100%;
  border-collapse: collapse;
  margin-top: 1rem;
}
.BlocksTable th, .BlocksTable td {
  padding: 0.75rem 1rem;
  text-align: left;
  border-bottom: 1px solid #333;
}


@media screen and (max-width: 600px) {
.tm-page-main{padding-bottom: 10rem;}

}


/* Scrollable table with sticky header + sticky first column */
.table-container {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}


 

.table-container th,
.table-container td {
  padding: 12px 14px;
  white-space: nowrap;       /* keep single-line cells on mobile */
}

.table-container thead th {
  position: sticky;
  top: 0;
  z-index: 3;
}



/* Ensure header’s first cell stays above the sticky column */
.table-container thead th:first-child { z-index: 4; }



/* Compact mode on small screens (no labels involved) */
@media (max-width: 640px) {
  .table-container th,
  .table-container td { padding: 10px 12px; }
  .table-container .time-ago,
  .table-container .stamps { display: none; } /* trim secondary lines */
  .table-container .function-name {
    max-width: 180px; overflow: hidden; text-overflow: ellipsis;
  }
}

/* Dark mode nice defaults */
@media (prefers-color-scheme: dark) {
  :root {
    --tbl-border: #2b2f36;
    --tbl-head:   #0b0d10;
    --tbl-sticky: #0b0d10;
    --tbl-row-odd:#0e1116;
    --tbl-hover:  #111827;
  }
}
